+      const upgradeEffect = Socket.fromWebSocket(Effect.flatMap(lazyWss, wss => Effect.acquireRelease(Effect.callback(resume => {
+        // Settle failed/aborted handshakes even while acquisition is uninterruptible.
+        let settled = false;
+        const cleanup = () => {
+          socket.off("close", abort);
+          socket.off("error", abort);
+        };
+        const abort = () => {
+          if (settled) return;
+          settled = true;
+          cleanup();
+          resume(Effect.interrupt);
+        };
+        socket.once("close", abort);
+        socket.once("error", abort);
+        if (socket.destroyed || !socket.readable || !socket.writable) {
+          abort();
+        } else {
+          try {
+            wss.handleUpgrade(nodeRequest, socket, head, ws => {
+              if (settled) {
+                ws.terminate();
+                return;
+              }
+              settled = true;
+              cleanup();
+              resume(Effect.succeed(ws));
+            });
+          } catch (cause) {
+            if (!settled) {
+              settled = true;
+              cleanup();
+              resume(Effect.die(cause));
+            }
+          }
+        }
+        return Effect.sync(cleanup);
+      }), ws => Effect.sync(() => ws.close()))));
       const map = new Map(services.mapUnsafe);
       map.set(HttpServerRequest.key, new ServerRequestImpl(nodeRequest, nodeResponse, upgradeEffect));
       const fiber = Fiber.runIn(Effect.runForkWith(ServiceMap.makeUnsafe(map))(handledApp), options.scope);
